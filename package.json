{
  "name": "beautiful-game-data",
  "version": "0.1.0",
  "description": "Canonical data and import pipelines for The Beautiful Game.",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "diagnose:api-football": "node scripts/diagnose-api-football-coverage.js",
    "import:api-football:players": "node scripts/import-api-football-players.js",
    "import:api-football:league": "node scripts/import-api-football-league.js",
    "import:api-football:pro-league": "node scripts/import-api-football-pro-league.js",
    "derive:players": "node scripts/derive-players-from-snapshot.js",
    "derive:clubs": "node scripts/derive-clubs-from-league.js",
    "export:league-pack": "node scripts/export-league-pack.js",
    "scrape:soccerwiki:ratings": "node scripts/scrape-soccerwiki-ratings.js",
    "enrich:soccerwiki:missing-ratings": "node scripts/enrich-soccerwiki-missing-ratings.js",
    "train:smw-rating-model": "node scripts/train-smw-rating-model.js",
    "evaluate:smw-rating-model": "node scripts/evaluate-smw-rating-model.js",
    "train:registry-smw-rating-model": "node scripts/train-registry-smw-rating-model.js",
    "score:tbg-ratings": "node scripts/score-tbg-ratings.js",
    "gold-standard:inputs": "node scripts/export-gold-standard-inputs.js",
    "gold-standard:review": "node scripts/review-gold-standard-ratings.js",
    "gold-standard:coverage": "node scripts/audit-transfermarkt-gold-standard-coverage.js",
    "diagnose:smw-matches": "node scripts/diagnose-smw-matches.js",
    "fetch:transfermarkt:apify": "node scripts/fetch-apify-transfermarkt-values.js",
    "fetch:transfermarkt:wide": "node scripts/fetch-apify-transfermarkt-values.js --scope=wide --output=calibration/apify-transfermarkt-wide-dataset.json",
    "fetch:transfermarkt:universe": "node scripts/fetch-apify-transfermarkt-values.js --scope=universe --output=calibration/apify-transfermarkt-universe-dataset.json --includeGoldStandardRescue=false --allowSearchWithTargetedIds=true",
    "import:transfermarkt:master": "node scripts/import-transfermarkt-master.js",
    "import:transfermarkt:wide": "node scripts/import-transfermarkt-master.js --input=calibration/apify-transfermarkt-wide-dataset.json --mergeExisting=true",
    "import:transfermarkt:universe": "node scripts/import-transfermarkt-master.js --input=calibration/apify-transfermarkt-universe-dataset.json --mergeExisting=true",
    "export:club-universe-scope": "node scripts/export-tbg-club-universe-scope.js",
    "audit:club-universe": "node scripts/audit-tbg-club-universe-matches.js",
    "build:player-registry": "node scripts/build-player-registry.js",
    "resolve:player-identities": "node scripts/resolve-player-identities.js",
    "link:soccerwiki-registry": "node scripts/link-soccerwiki-registry.js"
  },
  "dependencies": {
    "apify-client": "^2.12.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
